{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake build",
            "type": "shell",
            "command": "cmake -B build -DCMAKE_BUILD_TYPE=Debug && cmake --build build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "run tests",
            "type": "shell",
            "command": "cmake -B build -DCMAKE_BUILD_TYPE=Debug && cmake --build build && ./build/demofr_tests",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
